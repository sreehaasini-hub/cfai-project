# 🎲 Snake and Ladders - Google Colab Full Code
# Digital Board Game Simulation System
# ============================================

# =========================
# STEP 1: IMPORT LIBRARIES
# =========================

import random
import pandas as pd
import matplotlib.pyplot as plt

# =========================
# STEP 2: DEFINE BOARD
# =========================

snakes = {
    16: 6,
    47: 26,
    49: 11,
    56: 53,
    62: 19,
    64: 60,
    87: 24,
    93: 73,
    95: 75,
    98: 78
}

ladders = {
    1: 38,
    4: 14,
    9: 31,
    21: 42,
    28: 84,
    36: 44,
    51: 67,
    71: 91,
    80: 100
}

# =========================
# STEP 3: PLAYER INPUT
# =========================

num_players = int(input("Enter number of players (2-4): "))

players = []
positions = []
dice_history = []
turns = 0

for i in range(num_players):
    name = input(f"Enter Player {i+1} Name: ")
    players.append(name)
    positions.append(0)

# =========================
# STEP 4: START GAME
# =========================

print("\n🎲 Snake and Ladders Game Started!")
print("Reach position 100 to win.\n")

winner = None

# =========================
# STEP 5: GAME LOOP
# =========================

while winner is None:

    for i in range(num_players):

        input(f"{players[i]}'s turn. Press Enter to roll the dice...")

        dice = random.randint(1, 6)

        dice_history.append(dice)

        turns += 1

        print(f"{players[i]} rolled: {dice}")

        # Move player
        if positions[i] + dice <= 100:
            positions[i] += dice

        print(f"{players[i]} moved to {positions[i]}")

        # Ladder Check
        if positions[i] in ladders:
            print("🎉 Ladder Found!")
            positions[i] = ladders[positions[i]]
            print(f"{players[i]} climbed to {positions[i]}")

        # Snake Check
        elif positions[i] in snakes:
            print("🐍 Snake Bite!")
            positions[i] = snakes[positions[i]]
            print(f"{players[i]} slid to {positions[i]}")

        # Winner Check
        if positions[i] == 100:
            winner = players[i]
            break

        print("\nCurrent Positions:")

        for j in range(num_players):
            print(f"{players[j]} : {positions[j]}")

        print("-" * 40)

# =========================
# STEP 6: DISPLAY RESULTS
# =========================

print("\n==========================")
print("🏆 GAME OVER")
print("==========================")

print(f"\nWinner: {winner}")

print(f"Total Turns: {turns}")

# =========================
# STEP 7: CREATE DASHBOARD DATA
# =========================

results = pd.DataFrame({
    "Player": players,
    "Final Position": positions
})

print("\nFinal Results:")

print(results)

# =========================
# STEP 8: FINAL POSITION GRAPH
# =========================

plt.figure(figsize=(8,5))

plt.bar(
    results["Player"],
    results["Final Position"]
)

plt.title("Final Player Positions")

plt.ylabel("Board Position")

plt.xlabel("Players")

plt.ylim(0,100)

plt.show()

# =========================
# STEP 9: DICE DISTRIBUTION
# =========================

dice_count = pd.Series(dice_history).value_counts().sort_index()

plt.figure(figsize=(8,5))

plt.bar(
    dice_count.index,
    dice_count.values
)

plt.title("Dice Roll Distribution")

plt.xlabel("Dice Value")

plt.ylabel("Frequency")

plt.xticks([1,2,3,4,5,6])

plt.show()

# =========================
# STEP 10: GAME SUMMARY
# =========================

print("\n==========================")
print("📋 GAME SUMMARY")
print("==========================")

for i in range(num_players):
    print(
        f"{players[i]} reached position {positions[i]}"
    )

print(f"\nWinner: {winner}")

print(f"Total Dice Rolls: {len(dice_history)}")

print(f"Total Turns Played: {turns}")

# =========================
# STEP 11: SAVE RESULTS CSV
# =========================

results["Winner"] = [
    "Yes" if player == winner else "No"
    for player in players
]

results.to_csv(
    "snake_ladders_results.csv",
    index=False
)

print("\n✅ Results Saved Successfully")

print("📁 File Name: snake_ladders_results.csv")
