import java.util.HashMap;
import java.util.Map;
import java.util.Random;
import java.util.Scanner;

public class SnakesAndLadders {

    public static void main(String[] args) {

        Scanner scanner = new Scanner(System.in);
        Random random = new Random();

        // CO5: Probability concept – Random dice generation (1–6)
        // Dice outcomes are equally likely.

        // CO3: Constraint representation using rules
        // Snakes represent game constraints (Head → Tail).
        Map<Integer, Integer> snakes = new HashMap<>();
        snakes.put(99, 54);
        snakes.put(70, 55);
        snakes.put(52, 42);
        snakes.put(25, 2);
        snakes.put(95, 72);

        // CO3: Constraint representation using rules
        // Ladders represent game rules (Bottom → Top).
        Map<Integer, Integer> ladders = new HashMap<>();
        ladders.put(6, 25);
        ladders.put(11, 40);
        ladders.put(60, 85);
        ladders.put(46, 90);
        ladders.put(17, 69);

        // CO1: State representation
        // Stores the current state of each player.
        int[] positions = {0, 0};

        String[] players = {"Player 1", "Player 2"};

        // CO4: Multi-agent reasoning basics
        // Tracks whose turn it is.
        int currentPlayer = 0;

        System.out.println("=== Welcome to Snakes and Ladders ===");
        System.out.println("First player to reach exactly 100 wins!");

        while (true) {

            System.out.println("\n" + players[currentPlayer] + "'s turn.");
            System.out.print("Press Enter to roll the dice...");
            scanner.nextLine();

            // CO5: Probability review
            // Random dice simulation.
            int dice = random.nextInt(6) + 1;

            System.out.println(players[currentPlayer] + " rolled: " + dice);

            // CO1: Transition model
            // Action (dice roll) changes the state.
            int newPosition = positions[currentPlayer] + dice;

            // CO3: Constraint handling
            // Exact 100 rule.
            if (newPosition > 100) {
                System.out.println("Cannot move. Need exact number to reach 100.");
            } else {

                positions[currentPlayer] = newPosition;

                // CO6: Explainable reasoning traces
                // Display current action performed.
                System.out.println(players[currentPlayer]
                        + " moved to "
                        + positions[currentPlayer]);

                // CO3: Constraint checking
                // Ladder rule applied.
                if (ladders.containsKey(positions[currentPlayer])) {

                    int oldPos = positions[currentPlayer];

                    positions[currentPlayer] =
                            ladders.get(oldPos);

                    // CO6: Explainability
                    System.out.println("Ladder! Climbed from "
                            + oldPos + " to "
                            + positions[currentPlayer]);
                }

                // CO3: Constraint checking
                // Snake rule applied.
                else if (snakes.containsKey(positions[currentPlayer])) {

                    int oldPos = positions[currentPlayer];

                    positions[currentPlayer] =
                            snakes.get(oldPos);

                    // CO6: Explainability
                    System.out.println("Snake! Slid from "
                            + oldPos + " to "
                            + positions[currentPlayer]);
                }

                // CO1: Goal test
                // Check whether goal state is reached.
                if (positions[currentPlayer] == 100) {

                    System.out.println("\n🏆 "
                            + players[currentPlayer]
                            + " wins the game!");

                    break;
                }
            }

            // CO6: Trace logging
            // Displays the state after each move.
            System.out.println("Current Positions:");
            System.out.println("Player 1: " + positions[0]);
            System.out.println("Player 2: " + positions[1]);

            // CO4: Multi-agent reasoning
            // Switch control between players.
            currentPlayer = (currentPlayer + 1) % 2;
        }

        scanner.close();
    }
}
